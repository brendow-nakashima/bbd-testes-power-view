          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/xml" }],
            "body": {
              "mode": "raw",
              "raw": "{{PVD_TAREFAS_XML}}"
            },
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/{{PVD_TOKEN_USUARIO}}/produtos/{{PVD_TOKEN_PRODUTO}}/tarefas",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "{{PVD_TOKEN_USUARIO}}", "produtos", "{{PVD_TOKEN_PRODUTO}}", "tarefas"]
            }
          }
        }
      ]
    },
    {
      "name": "[07] Encerramento",
      "description": "DELETE shutdown publica a24h/{deviceId}/shutdown e o device aparece offline até o próximo startup/keep-alive. Só roda com PVD_ADAPTER_ESCRITA_SENSIVEL = true.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('PVD_TOKEN_PRODUTO') || pm.environment.get('PVD_ADAPTER_ESCRITA_SENSIVEL') !== 'true') {",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Shutdown → 200 [opcional]",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/{{PVD_TOKEN_USUARIO}}/software/shutdown/{{PVD_TOKEN_PRODUTO}}",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "{{PVD_TOKEN_USUARIO}}", "software", "shutdown", "{{PVD_TOKEN_PRODUTO}}"]
            }
          }
        }
      ]
    },
    {
      "name": "[08] Erros",
      "description": "Casos negativos que não dependem de sessão válida.",
      "item": [
