            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Login inexistente (e não a senha errada da conta real) para não contar tentativa contra ela.",
                  "pm.variables.set('LOGIN_INEXISTENTE', 'bbd-tests-inexistente-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
