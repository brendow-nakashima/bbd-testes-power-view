          "name": "Enviar tarefas (devolve a mesma agenda) → 201 [opcional]",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('PVD_ADAPTER_ESCRITA_SENSIVEL') !== 'true' || !pm.collectionVariables.get('PVD_TAREFAS_XML')) {",
                  "    console.log('[pvd-adapter] POST de tarefas pulado (PVD_ADAPTER_ESCRITA_SENSIVEL != true ou GET sem corpo).');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
