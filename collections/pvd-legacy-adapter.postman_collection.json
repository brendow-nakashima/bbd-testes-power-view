                  "pm.test('Status 401 (4xx do alert-service vira 401 legado)', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/xml" }],
            "body": {
              "mode": "raw",
              "raw": "<usuario><login>{{LOGIN_INEXISTENTE}}</login><senha>senha-qualquer</senha></usuario>"
            },
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/token",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "token"]
            }
          }
        },
        {
          "name": "[Erro] Token de usuário inválido → 400",
