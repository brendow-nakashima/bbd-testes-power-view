    {
      "name": "[02] Sessão — login",
      "description": "POST /api/usuarios/token. O adapter loga o usuário no alert-service e devolve um token de sessão próprio (UUID, em memória). Dois formatos aceitos: XML puro e o form-urlencoded que o PowerView manda (commit a024283, 2026-11-05).",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('ALERT_USER_LOGIN') || !pm.environment.get('ALERT_USER_PASSWORD')) {",
              "    console.warn('[pvd-adapter] ALERT_USER_LOGIN/ALERT_USER_PASSWORD vazios: login pulado, e as pastas [03] a [07] também.');",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Login (XML)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var m = pm.response.text().match(/<response>\\s*<token>([^<]+)<\\/token>\\s*<\\/response>/);",
                  "pm.test('<response><token> presente', function () { pm.expect(m, pm.response.text()).to.not.be.null; });",
                  "if (m) { pm.collectionVariables.set('PVD_TOKEN_USUARIO', m[1]); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/xml" }],
            "body": {
              "mode": "raw",
              "raw": "<usuario><login>{{ALERT_USER_LOGIN}}</login><senha>{{ALERT_USER_PASSWORD}}</senha></usuario>"
            },
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/token",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "token"]
            }
          }
        },
        {
          "name": "Login (form-urlencoded, formato do PowerView)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// O PowerView manda o XML como chave de formulário sem valor: %3Cusuario%3E...%3C%2Fusuario%3E=",
                  "var xml = '<usuario><login>' + pm.environment.get('ALERT_USER_LOGIN') + '</login><senha>' + pm.environment.get('ALERT_USER_PASSWORD') + '</senha></usuario>';",
                  "pm.collectionVariables.set('PVD_LOGIN_FORM', encodeURIComponent(xml) + '=');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('<response><token> presente', function () {",
                  "    pm.expect(pm.response.text()).to.match(/<response>\\s*<token>[^<]+<\\/token>\\s*<\\/response>/);",
                  "});",
                  "pm.collectionVariables.set('PVD_LOGIN_FORM', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "raw",
              "raw": "{{PVD_LOGIN_FORM}}"
            },
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/token",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "[03] Produtos e associação",
      "description": "listarProdutos monta IDs legados (1, 2, ...) por sessão a partir dos devices do usuário no alert-service. associar faz o login do agente com o serial do produto e grava o deviceId na sessão; só depois disso os endpoints do device funcionam.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('PVD_TOKEN_USUARIO')) { pm.execution.skipRequest(); }"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "[Erro] Startup antes de associar → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('<erro> com \"Produto não associado\"', function () {",
                  "    pm.expect(pm.response.text()).to.include('<code>400</code>').and.include('Produto n');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/{{PVD_TOKEN_USUARIO}}/software/startup/sem-produto",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "{{PVD_TOKEN_USUARIO}}", "software", "startup", "sem-produto"]
            }
          }
        },
        {
          "name": "Listar produtos e achar o device de bancada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.text();",
                  "pm.test('Raiz <list>', function () { pm.expect(body).to.match(/^\\s*<list[\\s>\\/]/); });",
                  "var serial = pm.environment.get('ALERT_TI_SERIAL');",
                  "var produtos = body.match(/<produto>[\\s\\S]*?<\\/produto>/g) || [];",
                  "var alvo = produtos.find(function (p) { return p.indexOf('<serial>' + serial + '</serial>') !== -1; });",
                  "pm.test('Produto com serial ' + serial + ' na lista (' + produtos.length + ' produto(s))', function () {",
                  "    pm.expect(alvo, 'A conta ALERT_USER_LOGIN não tem o device ' + serial).to.exist;",
                  "});",
                  "if (alvo) {",
                  "    var id = alvo.match(/<produto>\\s*<id>([^<]+)<\\/id>/);",
                  "    pm.test('Produto tem <id> legado', function () { pm.expect(id).to.not.be.null; });",
                  "    if (id) { pm.collectionVariables.set('PVD_PRODUTO_ID', id[1]); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/{{PVD_TOKEN_USUARIO}}/software/1/produtos",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "{{PVD_TOKEN_USUARIO}}", "software", "1", "produtos"]
            }
          }
        },
        {
          "name": "Associar o produto (login do agente)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('PVD_PRODUTO_ID')) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var m = pm.response.text().match(/<software>\\s*<tokenProduto>([^<]+)<\\/tokenProduto>\\s*<\\/software>/);",
                  "pm.test('<software><tokenProduto> (deviceId) presente', function () { pm.expect(m, pm.response.text()).to.not.be.null; });",
                  "if (m) { pm.collectionVariables.set('PVD_TOKEN_PRODUTO', m[1]); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/xml" }],
            "body": {
              "mode": "raw",
              "raw": "<software/>"
            },
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/{{PVD_TOKEN_USUARIO}}/produtos/{{PVD_PRODUTO_ID}}/associar",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "{{PVD_TOKEN_USUARIO}}", "produtos", "{{PVD_PRODUTO_ID}}", "associar"]
            }
          }
        }
      ]
    },
