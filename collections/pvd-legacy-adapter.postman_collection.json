                  "pm.test('<erro> com \"Token de usuário inválido\"', function () {",
                  "    pm.expect(pm.response.text()).to.include('<code>400</code>').and.include('Token de usu');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
