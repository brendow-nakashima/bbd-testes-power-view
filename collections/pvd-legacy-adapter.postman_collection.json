    {
      "name": "[06] Tarefas",
      "description": "GET lê a agenda do device. O POST sincroniza a agenda a partir do device (sobrescreve): só roda com PVD_ADAPTER_ESCRITA_SENSIVEL = true e devolve exatamente o XML que o GET leu.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('PVD_TOKEN_PRODUTO')) { pm.execution.skipRequest(); }"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Baixar tarefas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.text();",
                  "pm.test('Raiz <list>', function () { pm.expect(body).to.match(/^\\s*<list[\\s>\\/]/); });",
                  "var n = (body.match(/<tarefa>/g) || []).length;",
                  "console.log('[pvd-adapter] agenda do device: ' + n + ' tarefa(s)');",
                  "pm.collectionVariables.set('PVD_TAREFAS_XML', body);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{PVD_REST_BASE_URL}}/api/usuarios/{{PVD_TOKEN_USUARIO}}/produtos/{{PVD_TOKEN_PRODUTO}}/tarefas",
              "host": ["{{PVD_REST_BASE_URL}}"],
              "path": ["api", "usuarios", "{{PVD_TOKEN_USUARIO}}", "produtos", "{{PVD_TOKEN_PRODUTO}}", "tarefas"]
            }
          }
        },
