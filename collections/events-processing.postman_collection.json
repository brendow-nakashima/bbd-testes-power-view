    {
      "name": "[03] Status do Dispositivo",
      "item": [
        {
          "name": "Status do dispositivo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Tem o formato de status composto', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(b).to.have.property('deviceId');",
                  "    pm.expect(b.online).to.be.a('boolean');",
                  "    pm.expect(b.indicators).to.be.an('array');",
                  "});",
                  "pm.test('Indicadores trafegam chave, nao texto', function () {",
                  "    var b = pm.response.json();",
                  "    b.indicators.forEach(function (i) {",
                  "        pm.expect(i).to.have.property('key');",
                  "        pm.expect(i.active).to.be.a('boolean');",
                  "        pm.expect(i).to.have.property('descriptionKey');",
                  "    });",
                  "    // rotulo pronto em PT-BR nao pode voltar a vazar por este endpoint",
                  "    pm.expect(JSON.stringify(b)).to.not.include('meterType');",
                  "    pm.expect(JSON.stringify(b)).to.not.include('\"description\"');",
                  "});",
                  "pm.test('Traz a linha de conexao', function () {",
                  "    var b = pm.response.json();",
                  "    var keys = b.indicators.map(function (i) { return i.key; });",
                  "    pm.expect(keys).to.include('connectionStatus');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{EVENTS_BASE_URL}}/api/v1/devices/status/{{EVENTS_DEVICE_ID}}",
              "host": ["{{EVENTS_BASE_URL}}"],
              "path": ["api", "v1", "devices", "status", "{{EVENTS_DEVICE_ID}}"]
            }
