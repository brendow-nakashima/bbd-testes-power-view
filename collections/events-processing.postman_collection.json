          }
        },
        {
          "name": "Agendar comando de tomada (F1 da 113, opt-in)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Opt-in: agenda um desligamento real da tomada do EVENTS_TI_DEVICE_ID. So local (RB-0003-A24H §4.2).",
                  "if (pm.variables.get('TOMADA_ESCRITA_SENSIVEL') !== 'true') {",
                  "    console.log('Pulado: escrita sensivel desligada (TOMADA_ESCRITA_SENSIVEL != true): ' + pm.info.requestName);",
                  "    pm.execution.skipRequest();",
                  "} else if (!pm.environment.get('EVENTS_TI_DEVICE_ID')) {",
                  "    console.log('Pulado: sem EVENTS_TI_DEVICE_ID no env. Rode antes alert-service [03] (RB-0003-A24H, S2).');",
                  "    pm.execution.skipRequest();",
                  "}",
                  "// Agenda o comando para daqui a poucos minutos, no formato que a tela usa:",
                  "// `${date}T${time}`, sem segundos e sem fuso. O backend interpreta no",
                  "// spring.jackson.time-zone (America/Sao_Paulo), que e o fuso desta maquina.",
                  "var minutos = Number(pm.environment.get('F1_MINUTOS_A_FRENTE') || 3);",
                  "var d = new Date(Date.now() + minutos * 60 * 1000);",
                  "var p = function (n) { return String(n).padStart(2, '0'); };",
                  "var stamp = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) +",
                  "            'T' + p(d.getHours()) + ':' + p(d.getMinutes());",
                  "pm.collectionVariables.set('F1_EXECUTION_AT', stamp);",
                  "console.log('[F1] executionAt = ' + stamp + '  (agora: ' + new Date().toString() + ')');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Resposta traz taskId e status', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(b).to.have.property('taskId');",
                  "    pm.expect(b.taskId, 'taskId').to.be.a('string').and.not.empty;",
                  "    pm.expect(b).to.have.property('status');",
                  "});",
                  "// O `programada`, o `frequencia` e o `targetOutlet` NAO voltam nesta resposta:",
                  "// CreatedTaskResponse tem so {taskId, status}. Eles se verificam no fio, com",
                  "// mosquitto_sub -t 'pvd/+/task'. Ver a F1 do PI-0006-A24H.",
                  "console.log('[F1] resposta: ' + pm.response.text());",
                  "console.log('[F1] agendado para: ' + pm.collectionVariables.get('F1_EXECUTION_AT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{EVENTS_TI_DEVICE_ID}}\",\n  \"type\": 11,\n  \"frequency\": 1,\n  \"executionAt\": \"{{F1_EXECUTION_AT}}\",\n  \"duration\": 0,\n  \"scheduled\": true,\n  \"targetOutlet\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{EVENTS_BASE_URL}}/api/v1/tasks",
              "host": ["{{EVENTS_BASE_URL}}"],
              "path": ["api", "v1", "tasks"]
            },
            "description": "Verificacao F1 do PI-0006-A24H (atividade 113): prova que uma tarefa de Tomada Independente com `scheduled: true` desce pelo canal e e guardada pelo PVD ate o minuto marcado.\n\nPRE-REQUISITOS, nesta ordem:\n1. Ambiente do RB-0001 de pe, com o events-processing na 8082.\n2. Capacidade publicada para o device, porque o firmware nunca publica outlet-capacity:\n   docker exec mosquitto-mqtt-broker mosquitto_pub -h 127.0.0.1 -p 1883 -q 1 \\\n     -t \"a24h/{{EVENTS_TI_DEVICE_ID}}/outlet-capacity\" -m '{\"outletCount\":2}'\n3. Um assinante observando o fio ANTES de rodar:\n   docker exec mosquitto-mqtt-broker mosquitto_sub -h 127.0.0.1 -p 1883 -t 'pvd/+/task' -v\n\nATENCAO ao device: usa EVENTS_TI_DEVICE_ID, o UPS de bancada ao qual o PVD esta conectado. NAO usa o device-seed EVENTS_DEVICE_ID, que nenhum PVD escuta.\n\ntype 11 = Desligar Tomada Independente, no catalogo da main (ADR-0009-A24H v8). Ate 11/11 era o 8, que deixou de existir. frequency 1 = Uma vez."
          }
        }
      ]
    },
