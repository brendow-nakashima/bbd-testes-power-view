            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{EVENTS_BASE_URL}}/actuator/health",
              "host": ["{{EVENTS_BASE_URL}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    },
