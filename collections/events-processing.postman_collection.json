        {
          "name": "Tipos de task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Array de {id, description}', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(b).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(b[0]).to.have.property('id');",
                  "    pm.expect(b[0]).to.have.property('description');",
                  "});",
                  "// Catalogo da main com a tomada em 10 a 12 (ADR-0009-A24H v8, merge da main de 11/11).",
                  "// 7 e 8 vazios, 9 reservado: nenhum dos tres pode aparecer.",
                  "pm.test('Catalogo da main: 1 a 6 e a tomada em 10, 11 e 12', function () {",
                  "    var ids = pm.response.json().map(function (t) { return Number(t.id); }).sort(function (a, c) { return a - c; });",
                  "    pm.expect(ids).to.eql([1, 2, 3, 4, 5, 6, 10, 11, 12]);",
                  "});",
                  "pm.test('Descricoes da tomada em 10 a 12', function () {",
                  "    var byId = {};",
                  "    pm.response.json().forEach(function (t) { byId[Number(t.id)] = t.description; });",
                  "    pm.expect(byId[10]).to.eql('Ligar Tomada Independente');",
                  "    pm.expect(byId[11]).to.eql('Desligar Tomada Independente');",
                  "    pm.expect(byId[12]).to.eql('Reiniciar Tomada Independente');",
                  "    pm.expect(byId[1]).to.eql('Desligar e Ligar Nobreak');",
                  "});"
                ]
              }
            }
          ],
